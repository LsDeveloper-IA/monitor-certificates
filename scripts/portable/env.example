# Configuracao do Monitor de Certificados - pacote portatil
#
# Este arquivo e copiado para .env na primeira execucao. Os marcadores
# __GERAR_...__ sao substituidos por chaves aleatorias nesse momento.
# Preencha as integracoes que for usar e reinicie o executavel.

SECRET_KEY=__GERAR_SECRET_KEY__
FRONTEND_ORIGIN=http://127.0.0.1:5000
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
INTEGRACAO_API_KEY=__GERAR_INTEGRACAO_API_KEY__
AUTOMACAO_EXECUTION_KEY=__GERAR_AUTOMACAO_EXECUTION_KEY__
AUTOMACAO_ADMIN_KEY=__GERAR_AUTOMACAO_ADMIN_KEY__
API_MONITOR_URL=http://127.0.0.1:5000

# Deixe vazio para usar a pasta storage/ ao lado do executavel.
STORAGE_DIR=

# Falha ao iniciar se as chaves ainda forem exemplos. Mantenha "nao" no
# pacote portatil; o proprio inicializador gera as chaves.
MONITOR_CONFIG_STRICT=nao

# Caminho opcional para o Python que executa as automacoes. Sem ele, o
# executavel procura "python" no PATH. As automacoes tambem precisam das
# dependencias de automacoes/*/requirements.txt e do Chromium do Playwright.
MONITOR_PYTHON_EXE=

# Banco de clientes (ODBC de 64 bits).
ODBC_DSN=srvcontabil
ODBC_USUARIO=
ODBC_SENHA=

# Comportamento das automacoes.
MODO_AUTOMATICO=sim
ATUALIZAR_EXCEL_AUTOMATICO=nao
SINCRONIZAR_API_AUTOMATICO=sim
ENVIAR_EMAIL_AUTOMATICO=nao
ENVIAR_WHATSCONTABIL_AUTOMATICO=nao
ENVIAR_RESUMO_ATUALIZACOES_AUTOMATICO=nao
EMAIL_RESUMO_ATUALIZACOES=

# E-mail (Gmail com OAuth2).
EMAIL_REMETENTE=

# WhatsContabil.
WHATSCONTABIL_URL=
WHATSCONTABIL_TOKEN=
MODO_WHATSCONTABIL=teste
WHATSCONTABIL_PERMITIR_NUMEROS_REAIS=nao
WHATSCONTABIL_ESCOPO_ENVIO_TESTE=nenhum
IGNORAR_DUPLICIDADE_WHATSCONTABIL_TESTE=nao
WHATSCONTABIL_NUMERO_TESTE=
WHATSCONTABIL_WHATSAPP_ID=
WHATSCONTABIL_TEMPLATE_TESTE=
WHATSCONTABIL_TEMPLATE_EQUIPE_TESTE=resumo_pendencias_certificados
WHATSCONTABIL_TEMPLATE_RESPONSAVEL_TESTE=resumo_renovacoes_responsavel
WHATSCONTABIL_TEMPLATE_EQUIPE_DOCUMENTO_TESTE=relatorio_pendencias_certificados
WHATSCONTABIL_TEMPLATE_RESPONSAVEL_DOCUMENTO_TESTE=relatorio_renovacoes_responsavel
WHATSCONTABIL_TEMPLATE_RELATORIO_LINK_TESTE=
WHATSCONTABIL_TEMPLATE_ABERTURA_RELATORIO_TESTE=
WHATSCONTABIL_PERMITIR_FALLBACK_MIDIA_TESTE=nao
WHATSCONTABIL_NOME_DESTINATARIO_TESTE=Equipe Office
WHATSCONTABIL_NOME_RESPONSAVEL_TESTE=Responsavel

# Certificados e Google Drive.
PASTA_CERTIFICADOS=
ARQUIVO_EXCEL=
GOOGLE_DRIVE_PASTA_E_CNPJ_ID=
GOOGLE_DRIVE_PASTA_RELATORIOS_ID=
GOOGLE_DRIVE_PASTA_RELATORIOS_PDF_ID=
GOOGLE_DRIVE_RELATORIOS_PERMISSAO=restrito
GOOGLE_DRIVE_RELATORIOS_LEITOR=
GOOGLE_DRIVE_CREDENCIAIS_DIR=

# Login do portal Conthabil usado pela automacao Conthabil.
CONTHABIL_EMAIL=
CONTHABIL_SENHA=
