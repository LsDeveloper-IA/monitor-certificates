# Login do portal Conthabil. Estes valores sao obrigatorios.
CONTHABIL_EMAIL=
CONTHABIL_SENHA=

# URL da API do portal (normalmente nao precisa mudar).
CONTHABIL_API_URL=https://api.conthabilbr.com/api

# ID da pasta e-CNPJ no Google Drive.
GOOGLE_DRIVE_PASTA_E_CNPJ_ID=1XD29GlSrxVTGNZNB5SUanAK31ZZ7qWv4

# Pasta com credentials.json e token.json.
# Vazio = usa ./credenciais ou as credenciais da raiz do repositorio.
GOOGLE_DRIVE_CREDENCIAIS_DIR=

# Certificados enviados por lote ao portal.
CONTHABIL_LOTE=10

# Pasta de downloads e relatorios (vazio = ./dados).
CONTHABIL_SAIDA=

# Opcional para testes: nao envia nada ao portal.
CONTHABIL_SIMULAR=nao
