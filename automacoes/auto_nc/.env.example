SIEG_EMAIL=
SIEG_SENHA=
SIEG_SLOW_MO_MS=0
# Pasta raiz que contem uma subpasta por empresa (com .pfx/.p12 e senha).
# Se ficar vazia, herda o GOOGLE_DRIVE_FOLDER_ID do .env da raiz do projeto.
GOOGLE_DRIVE_FOLDER_ID=
# Pasta onde os relatorios JSON sao publicados.
AUTO_NC_REPORT_FOLDER_ID=

# Opcional: processa somente uma empresa (nome ou CNPJ) e encerra.
# Nesse modo os relatorios existentes nao sao alterados.
AUTO_NC_EMPRESA_ALVO=
AUTO_NC_CNPJ_ALVO=
