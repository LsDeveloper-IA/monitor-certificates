SECRET_KEY=gere-uma-chave-segura
FRONTEND_ORIGIN=http://localhost:3000
INTEGRACAO_API_KEY=gere-uma-chave-segura
AUTOMACAO_EXECUTION_KEY=gere-outra-chave-interna-segura
API_MONITOR_URL=http://localhost:5000

MODO_AUTOMATICO=sim
ATUALIZAR_EXCEL_AUTOMATICO=nao
SINCRONIZAR_API_AUTOMATICO=sim
ENVIAR_EMAIL_AUTOMATICO=nao
ENVIAR_WHATSCONTABIL_AUTOMATICO=nao

# Integracao WhatsContabil. O token real deve existir somente no .env local.
WHATSCONTABIL_URL=https://endereco-da-api
WHATSCONTABIL_TOKEN=token-local-nao-versionar
MODO_WHATSCONTABIL=teste
WHATSCONTABIL_PERMITIR_NUMEROS_REAIS=nao
WHATSCONTABIL_ESCOPO_ENVIO_TESTE=nenhum
IGNORAR_DUPLICIDADE_WHATSCONTABIL_TESTE=nao
WHATSCONTABIL_NUMERO_TESTE=55DDDNUMERO
WHATSCONTABIL_WHATSAPP_ID=2
WHATSCONTABIL_TEMPLATE_TESTE=nome_do_template_aprovado
WHATSCONTABIL_TEMPLATE_EQUIPE_TESTE=resumo_pendencias_certificados
WHATSCONTABIL_TEMPLATE_RESPONSAVEL_TESTE=resumo_renovacoes_responsavel
# Templates Utility novos, ambos com cabecalho do tipo Documento.
WHATSCONTABIL_TEMPLATE_EQUIPE_DOCUMENTO_TESTE=relatorio_pendencias_certificados
WHATSCONTABIL_TEMPLATE_RESPONSAVEL_DOCUMENTO_TESTE=relatorio_renovacoes_responsavel
# Um unico template Utility com 3 variaveis: nome, descricao e link do relatorio.
WHATSCONTABIL_TEMPLATE_RELATORIO_LINK_TESTE=
# Template Utility sem cabecalho. Abre a conversa antes de enviar o PDF como midia.
WHATSCONTABIL_TEMPLATE_ABERTURA_RELATORIO_TESTE=
WHATSCONTABIL_PERMITIR_FALLBACK_MIDIA_TESTE=nao
WHATSCONTABIL_NOME_DESTINATARIO_TESTE=Equipe Office
WHATSCONTABIL_NOME_RESPONSAVEL_TESTE=Responsavel

PASTA_CERTIFICADOS=G:\caminho\para\certificados
ARQUIVO_EXCEL=G:\caminho\para\relatorio_certificados.xlsx
GOOGLE_DRIVE_PASTA_E_CNPJ_ID=id-da-pasta-no-drive
GOOGLE_DRIVE_PASTA_RELATORIOS_ID=id-da-pasta-de-relatorios-no-drive
# Pasta exclusiva para os PDFs enviados por link no WhatsContabil.
GOOGLE_DRIVE_PASTA_RELATORIOS_PDF_ID=id-da-pasta-de-pdfs
# Seguro por padrao: herda somente os leitores da pasta.
GOOGLE_DRIVE_RELATORIOS_PERMISSAO=restrito
# Usado apenas quando a permissao for usuario ou dominio.
GOOGLE_DRIVE_RELATORIOS_LEITOR=
# Opcional: pasta onde ficam credentials.json e token.json
GOOGLE_DRIVE_CREDENCIAIS_DIR=

# Acrescente aqui as configuracoes ODBC e das integracoes usadas localmente.
